{
  "sourceLanguage": "en",
  "strings": {
    "mac.NSLocalNetworkUsageDescription": {
      "comment": "mac",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic connects to your iPhone over an encrypted local network or peer-to-peer voice link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic 通过本地网络或点对点链路与你的 iPhone 建立加密语音连接。"
          }
        }
      }
    },
    "mac.NSBluetoothAlwaysUsageDescription": {
      "comment": "mac",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic connects to your iPhone over Bluetooth when the local network is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic 在局域网不可用时通过蓝牙点对点连接 iPhone。"
          }
        }
      }
    },
    "mac.NSScreenCaptureUsageDescription": {
      "comment": "mac",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic locates text in the target field on this Mac for the polish highlight. Screenshots are never saved or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic 仅在本机识别目标输入框的文字位置，用于润色完成时的扫光效果，不保存或上传截图。"
          }
        }
      }
    },
    "mac.NSHumanReadableCopyright": {
      "comment": "mac",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic · Voice input, one step less."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic · 语音输入，少一步。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic finds and connects to your Mac on your local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic 在你的局域网内寻找并连接你的 Mac。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic uses your microphone to send your voice to your Mac for recognition in real time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic 需要使用麦克风，把你说的话实时发送到你的 Mac 转成文字。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic uses Apple Speech for temporary live preview text. The model on your Mac still corrects the final result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic 使用 Apple Speech 生成临时预览文字，最终结果仍由 Mac 上的模型校准。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic connects to your Mac over Bluetooth when the local network is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic 在局域网不可用时通过蓝牙连接你的 Mac。"
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic establishes a local voice link with your Mac over Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMic 通过蓝牙与你的 Mac 建立本地语音链路。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
